generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentVerificationDetail {
  id        Int       @unique @default(autoincrement())
  email     String    @unique
  password  String
  resetOtp  String? // Optional field for reset OTP
  otpExpiry DateTime?
  student   Student?
}

model TeacherVerificationDetail {
  id        Int       @unique @default(autoincrement())
  email     String    @unique
  password  String
  resetOtp  String? // Optional field for reset OTP
  otpExpiry DateTime?
  // teacherId Int       @unique 
  // teacher   Teacher   @relation(fields: [teacherId], references: [id])
  Teacher   Teacher?
}

model Admin {
  id        Int       @unique @default(autoincrement())
  email     String    @unique
  password  String
  resetOtp  String?
  otpExpiry DateTime?
}

model Teacher {
  id                          Int                       @id @default(autoincrement())
  firstName                   String
  middleName                  String?
  lastName                    String
  email                       String                    @unique
  phone                       String
  address                     String
  gender                      userGender
  img                         String?
  createdAt                   DateTime                  @default(now())
  subjects                    Subject[]
  classes                     Class[]
  teacherVerificationDetail   TeacherVerificationDetail @relation(fields: [teacherVerificationDetailId], references: [id])
  teacherVerificationDetailId Int                       @unique
}

model Student {
  id                          Int                       @id @default(autoincrement())
  firstName                   String
  middleName                  String?
  lastName                    String
  enrollmentNo                String?
  email                       String                    @unique
  phone                       String
  address                     String
  gender                      userGender
  dob                         DateTime
  fatherName                  String
  motherName                  String
  img                         String?
  createdAt                   DateTime                  @default(now())
  class                       Class                     @relation(fields: [classId], references: [id])
  classId                     Int
  attendances                 Attendance[]
  results                     Result[]
  studentVerificationDetail   StudentVerificationDetail @relation(fields: [studentVerificationDetailId], references: [id])
  studentVerificationDetailId Int                       @unique
}

model Class {
  id           Int            @id @default(autoincrement())
  className    String         @unique
  students     Student[]
  // events       Event[]
  notification Notification[]
  subjects     Subject[]
  // Teacher      Teacher?       @relation(fields: [teacherId], references: [id])
  // teacherId    Int?
  Teacher      Teacher[]
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers    Teacher[]
  exams       Exam[]
  assignments Assignment[]
  // Class       Class?       @relation(fields: [classId], references: [id])
  // classId     Int?
  classes     Class[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  results   Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  results   Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    Int
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  // classId     Int?
  // class       Class?   @relation(fields: [classId], references: [id])
}

model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

enum userGender {
  MALE
  FEMALE
  OTHERS
}
